API_URL=http://localhost:8080

# URL de la API para el servidor de Next dentro de Docker. En el VPS: http://sotra-backend:8080
API_URL_INTERNA=http://host.docker.internal:8080

# Sesión (Auth.js). AUTH_SECRET cifra la cookie de sesión: generar uno propio, por ejemplo con
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# y no compartirlo. AUTH_URL es la dirección pública del frontend (con https, la cookie pasa a ser segura).
AUTH_SECRET=
AUTH_URL=http://localhost

# Keycloak. KEYCLOAK_EMISOR es el emisor de los tokens y la dirección que abre el navegador para el login.
# KEYCLOAK_URL_INTERNA es por donde el servidor de Next llega a Keycloak dentro de Docker (token, renovación).
KEYCLOAK_EMISOR=http://localhost:9080/realms/sotra
KEYCLOAK_URL_INTERNA=http://host.docker.internal:9080
KEYCLOAK_CLIENTE=sotra-frontend
