# Producción (servicio sotra-frontend-prod). API_URL se usa al construir la imagen; el resto, al ejecutar el contenedor.
API_URL=http://localhost:8080
API_URL_INTERNA=

# Sesión (Auth.js): AUTH_SECRET propio y secreto; AUTH_URL, la dirección pública del frontend.
AUTH_SECRET=
AUTH_URL=http://localhost

# Keycloak: emisor público (navegador) y dirección interna (servidor de Next dentro de Docker).
KEYCLOAK_EMISOR=http://localhost:9080/realms/sotra
KEYCLOAK_URL_INTERNA=
KEYCLOAK_CLIENTE=sotra-frontend
